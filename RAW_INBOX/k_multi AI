function estimateEntropy(systemState) {
  // Approccio: Entropia informazionale Shannon
  
  // systemState = distribuzione di probabilità su stati discreti
  // Es: {stato_A: 0.5, stato_B: 0.3, stato_C: 0.2}
  
  let entropy = 0;
  const probabilities = Object.values(systemState);
  
  for (let p of probabilities) {
    if (p > 0) {
      entropy -= p * Math.log2(p);
    }
  }
  
  // Normalizza per massima entropia possibile
  const numStates = probabilities.length;
  const maxEntropy = Math.log2(numStates);
  
  return entropy / maxEntropy; // [0,1]
}
