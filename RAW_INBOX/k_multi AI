      calculateTopicUtilityInContext(topic, context)
    );
  }
  
  // 3. Calcola correlazioni tra utility di topic diversi
  const utilityCorrelations = [];
  const topicIds = Object.keys(topicUtility);
  
  for (let i = 0; i < topicIds.length; i++) {
    for (let j = i+1; j < topicIds.length; j++) {
      const corr = pearsonCorrelation(
        topicUtility[topicIds[i]],
        topicUtility[topicIds[j]]
